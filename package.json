{
  "name": "tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Rastreio de vendas WhatsApp × Google Ads",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/rate-limit": "^11.2.1",
    "better-sqlite3": "^13.0.3",
    "croner": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "htmx.org": "^2.0.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
