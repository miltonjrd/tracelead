# Domínio do tracker (Caddy emite o certificado HTTPS para ele automaticamente)
TRACK_DOMAIN=track.seudominio.com.br
BASE_URL=https://track.seudominio.com.br

# Gere com: openssl rand -hex 32
IP_HASH_SECRET=

# Quantas lojas podem ficar conectadas ao mesmo tempo pelo QR code (Baileys)
BAILEYS_MAX_SESSIONS=5

# WhatsApp Cloud API: só para clientes em modo cloud (app da Meta → Configurações → Básico / WhatsApp → Configuração)
META_APP_SECRET=
# Texto que você inventa e repete no campo "Verify token" do webhook na Meta
META_VERIFY_TOKEN=

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Gerado com: npm run cli -- google-auth
GOOGLE_ADS_REFRESH_TOKEN=
# ID da sua conta de administrador (MCC), se acessa o cliente por ela
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# Nomes exatos das ações de conversão criadas no Google Ads
CONVERSION_NAME_LEAD=Lead WhatsApp
CONVERSION_NAME_VENDA=Venda WhatsApp

# Backup externo opcional via rclone, configurado por variáveis (exemplo para S3/compatível):
# RCLONE_CONFIG_BACKUP_TYPE=s3
# RCLONE_CONFIG_BACKUP_PROVIDER=Other
# RCLONE_CONFIG_BACKUP_ENDPOINT=https://...
# RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
# RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=
# RCLONE_REMOTE=backup:nome-do-bucket/tracker
BACKUP_KEEP=14

# Fuso dos jobs diários (backup 3h, gasto 6h)
JOBS_TZ=America/Sao_Paulo
